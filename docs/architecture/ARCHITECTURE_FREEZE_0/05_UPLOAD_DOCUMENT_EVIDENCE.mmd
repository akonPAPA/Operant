  DUP -->|no| JOB["ProcessingJob PENDING"]
  JOB -.-> QAR["quarantine + malware scan"]:::ext
  QAR -.-> PARSE["OCR / parser (AI worker, advisory)"]:::ext
  PARSE -.-> EV["Evidence + extraction_result (aiadvisory)"]
  EV -.-> VAL["deterministic validation (decisiontrace)"]
  VAL --> INQ["-> Inquiry / WorkCase (View 04)"]
  DOC ==> AO["auditoutbox: DocumentQueued"]
  JOB -.->|lease| WL["WorkerJobLeaseService (fencing)"]

