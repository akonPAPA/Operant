flowchart TB
  U["UploadAdapter / ApiAdapter"] --> LIM["payload limits + auth"]
  LIM --> OS["ObjectStorageService.put (object_storage_record)"]:::store
  OS --> DOC["InboundDocument QUEUED + sha256 dedup"]
  DOC --> DUP{"duplicate (tenant+sha256)?"}
