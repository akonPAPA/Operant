*.swo
tmp/
temp/

# Java / Maven build outputs
**/target/

# Node / frontend build outputs
# NOTE: do NOT use depth-agnostic `**/out/` or `**/build/` here — they also match
# Java source packages copied into the release image:
#   `**/out/`   -> apps/core-api/.../application/port/out/ (main: aibot outbound ports)
#   `**/build/` -> apps/core-api/src/test/.../com/orderpilot/build/ (Dockerfile contract test)
# Stripping either breaks the in-image `mvn test` verify stage. Scope the Next.js
# static-export / build output to the frontend, where it is actually generated.
**/node_modules/
**/.next/
apps/web-dashboard/out/
apps/web-dashboard/build/
**/dist/
**/coverage/

# Python build/cache outputs
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Local test/cache artifacts
.audit_git_files.txt
*.zip
*.tar
*.tar.gz

# Not needed for core-api release Docker build from repo root.
# Keep apps/core-api, docs, and scripts available because apps/core-api/Dockerfile copies them.
apps/web-dashboard/
apps/ai-worker/